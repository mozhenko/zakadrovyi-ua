{
  "manifest_version": 3,
  "name": "Закадровий UA — озвучення відео українською",
  "short_name": "Закадровий UA",
  "version": "1.1.0",
  "description": "Читає субтитри YouTube українським голосом або перекладає їх українською (Google, DeepL, Claude) і озвучує поверх відео.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Закадровий UA",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tts", "offscreen", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://translate.google.com/*",
    "https://translate.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://api.anthropic.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["shared/settings.js", "content/core.js", "content/youtube.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-voice": {
      "suggested_key": { "default": "Alt+Shift+U" },
      "description": "Увімкнути / вимкнути озвучення"
    }
  }
}
